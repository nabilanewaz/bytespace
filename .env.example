# Google sign-in (optional). Copy to .env.local for local development and add
# the same variables in Vercel → Project → Settings → Environment Variables.
# Without them the site still works; the Google button shows a demo message.

# Random secret that encrypts the session cookie. Generate one with:
#   npx auth secret        (or: openssl rand -base64 32)
AUTH_SECRET=

# OAuth client from Google Cloud Console → APIs & Services → Credentials.
# Authorized redirect URIs:
#   http://localhost:3000/api/auth/callback/google
#   https://<your-vercel-domain>/api/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
